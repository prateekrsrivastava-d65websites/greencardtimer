  "methodology": {
    "kind": "historical-cutoff-scenarios",
    "title": "Historical cutoff pace scenarios",
    "description": "Each scenario asks when the selected cutoff could pass the priority date if it repeated a pace observed in the published Visa Bulletins. These are illustrations of past movement, not forecasts of visa supply, queue position, filing permission or individual approval.",
    "parameters": {
      "rollingWindowMonths": 6,
      "minimumHistoryMonths": 12,
      "minimumPositiveWindows": 3,
      "maximumHorizonMonths": 120
    },
    "steps": [
      "Use chronological, sourced monthly Final Action Date or Dates for Filing cutoffs for the selected country and category.",
      "Measure net cutoff movement across every complete six-month window. Include stalls and retrogression. Exclude windows containing Current, Unavailable, missing dates or missing months.",
      "Use the 25th, 50th and 75th percentiles of those observed net rates for slower, typical and faster pace illustrations. These overlapping windows are not independent probability samples.",
      "Only show scenarios with at least twelve months of history, three positive complete windows, a dated latest cutoff, and positive overall net movement.",
      "Advance by the number of whole bulletin months needed for the cutoff to pass, strictly, the entered date. A zero or negative pace has no finite date. Projections beyond ten years have no displayed date."
    ],
    "limitations": [
      "Future movement depends on visa demand, supply, policy and agency decisions and can differ completely from prior movement. Scenarios are not probability bounds.",
      "No USCIS inventory or I-140 queue is estimated. Approved petitions do not directly equal people or visa demand, and a filing cutoff hides applicants who cannot file.",
      "This dataset does not independently verify USCIS's monthly choice of the filing chart. Check the official USCIS page before filing I-485.",
      "Meeting a Final Action Date removes only the cutoff constraint. It does not establish approval, a reserved visa number, case readiness or a processing duration.",
      "For consular processing, the filing cutoff concerns assembly and submission of documents following National Visa Center instructions."
    ],
    "sourceUrls": [
      "https://travel.state.gov/content/travel/en/legal/visa-law0/visa-bulletin.html",
      "https://www.uscis.gov/visabulletininfo"
    ]
  },
  "sourceAccess": {
    "verifiedAt": "2026-10-11",
    "bulletins": "Twenty-five official DOS bulletins from October 2024 through October 2026 were retrieved through the web research tool and normalized. Source URLs and dates are included for each bulletin.",
    "inventory": "The current USCIS data index returned HTTP 403 during research. No current inventory was imported or inferred.",
    "automation": "GitHub Actions checks weekly. Official DOS HTML is fetched from travel.state.gov or its openly published adoption.state.gov/adoptions.state.gov hosts. Canonical sources and actual retrieval URLs are retained. All tracked cells and contiguous history are validated; errors preserve the published data. A monthly successful-check record does not change the data verification date."
